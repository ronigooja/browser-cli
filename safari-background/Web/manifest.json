{
  "manifest_version": 2,
  "name": "Agent Browser Safari Background",
  "description": "Local tab and page operations in an explicitly selected macOS Safari profile.",
  "version": "0.2.0",
  "permissions": ["nativeMessaging", "storage", "scripting", "webNavigation", "http://*/*", "https://*/*"],
  "background": {"scripts": ["read-page.js", "background.js"], "persistent": true},
  "browser_action": {"default_title": "Agent Browser Safari Setup", "default_popup": "setup.html"}
}
