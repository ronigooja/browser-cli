#!/bin/bash
# Drive the real, logged-in Safari or Google Chrome on macOS: manage tabs and run JavaScript.
# Usage: see `browser-cli help` or README.md. JavaScript needs "Allow JavaScript from Apple Events".
set -euo pipefail

VERSION=0.1.0
DEFAULT_TIMEOUT=30

if [ "${1-}" = mcp ] && [ "$#" -eq 1 ]; then
  python="$(command -v python3)" || { echo 'browser-cli: mcp requires Python 3' >&2; exit 1; }
  cli="$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")"
  exec "$python" "${cli%/*}/browser_mcp.py" "$cli"
fi

if [[ "$OSTYPE" = darwin* ]]; then
  export LC_ALL=en_US.UTF-8
fi
WORK="$(mktemp -d)"
cleanup() {
  local rc=$?
  trap - EXIT
  rm -rf "$WORK"
  exit "$rc"
}
trap cleanup EXIT

die() { echo "browser-cli: $*" >&2; exit 1; }
usage_error() { printf 'browser-cli: %s; see browser-cli help\n' "$*" >&2; exit 2; }

usage() {
  cat <<'EOF'
browser-cli --browser safari|chrome <command> [options]
browser-cli help | version | mcp

  tabs [--json]                 list tabs: <window>:<tab> <TAB> title <TAB> url
  open (--foreground | --background) <url>
                                reuse a matching tab or open a page; prints <target> <TAB> reused|created
                                Chrome background reuse requires an exact URL; other opens match prefixes
                                target: id:<tab-id> for Chrome background; otherwise <window>:<tab>
  install-background [--profile DIRECTORY]
                                Chrome only: prepare setup; you then click Load unpacked in Chrome
                                --check reports whether the extension is connected
  uninstall-background          Chrome only: remove setup files after removing the extension in Chrome
  close [--tab T]               close a tab
  eval [--tab T] <js>           run a JavaScript expression, print its value (strings as is, others as JSON)
  file [--tab T] <path.js>      same, with the expression read from a file
  info [--tab T]                print page metadata and detected challenge: none|cloudflare-passive|needs-human
  read-page --tab T [--selector CSS] [--wait-for-selector CSS] [--include-links] -- <exact-url>
                                guarded JSON read; T is a unique case-sensitive URL substring
                                for Safari or id:<id> for Chrome
  text [--tab T]                print page text
  links [--tab T]               print link text and absolute URL, tab-separated, one per line
  html [--tab T]                print sanitized page HTML
  snapshot [--tab T] [--selector CSS] [--max-chars N]
                                list visible controls with index, tag/role, label and CSS selector
  screenshot [--tab T] [--selector CSS] [--out PATH]
                                save a PNG and print its path; target must already be visible
  click [--tab T] <css>         click the first matching element
  fill [--tab T] <css> <text>   fill an input, textarea, or editable element
  select [--tab T] <css> <value>  select an option by value or label
  press [--tab T] <key> [--selector CSS]
                                dispatch key events for Enter, Escape, Tab, arrows, Backspace, Space or one character
  scroll [--tab T] [--selector CSS] (--to top|bottom | --by N)  scroll page or element
  submit [--tab T] <css>        request submission of the matched form or the element's form
  wait [--tab T] <js>           poll until the expression is truthy; no output on success
  wait-challenge [--tab T] [--timeout N]
                                wait while a passive challenge is detected; exit 1 if human verification is needed
                                prints challenge: none when no known challenge is detected
  status                        print on (exit 0), off (permission disabled, exit 1),
                                or unknown (no tab to probe, exit 1)

--browser safari|chrome required except for help, version and mcp
--tab T     <window>:<tab>, URL substring, or id:<chrome-tab-id> (Chrome only; see `tabs --json`)
            indexes are 1-based; URL substrings select the first match across windows
            default: front window's active tab
--background  open only: Safari opens or reuses a tab without bringing Safari to the front;
              Chrome reuses or creates a tab without focusing Chrome or changing the active tab.
              Chrome requires an HTTP(S) URL and a regular (non-Incognito) window in the one profile
              with the browser-cli extension connected. If not set up, this prompts before installation
              in a terminal. Use install-background --check to check the connection without opening a tab.
--foreground  open only: bring the browser to the front and select the target tab
--trusted   click, fill, or press: bring the target tab to the front and send real input (requires Accessibility permission)
--json      tabs only: array of {window,tab,title,url,id}; id is a string in Chrome, null in Safari
--timeout N positive integer seconds: total for wait, wait-challenge and Chrome background open;
            otherwise applies to individual browser calls (default 30; wait-challenge 600)
--selector CSS scope read-page, text, links, html, snapshot, screenshot, press, or scroll to the first matching element
--out PATH  screenshot only: PNG destination; overwrites an existing file (default: a new temp file)
--to top|bottom, --by N scroll only: choose destination or integer distance
--max-chars N limit output characters (default 20000 for text, links, html and snapshot;
              no limit for eval and file unless specified)
--raw       html only: return unmodified outerHTML
--          end option parsing
With no tabs, tabs succeeds with empty output (or [] with --json).
The page's security policy may block user JavaScript in eval, file, and wait. Promises are not awaited.
By default, page actions use JavaScript, not real input. Synthetic key events don't type or move focus like a keyboard.
Exit status: 0 success, 1 operation failed or status off/unknown, 2 invalid usage.
Results go to stdout; diagnostics go to stderr.
EOF
}

# ---- option parsing: sets BROWSER, TAB, TIMEOUT and ARGS (positional) ----
BROWSER=""
TAB=""; TIMEOUT="$DEFAULT_TIMEOUT"; TIMEOUT_SET=0; BACKGROUND=0; FOREGROUND=0; TRUSTED=0; TRUSTED_SENDING=0; JSON=0; ARGS=()
SELECTOR=""; SELECTOR_SET=0; MAX_CHARS=""; MAX_CHARS_SET=0; RAW=0; INCLUDE_LINKS=0
WAIT_SELECTOR=""; WAIT_SELECTOR_SET=0
TO=""; TO_SET=0; BY=""; BY_SET=0
OUT=""; OUT_SET=0
parse() {
  ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --browser) [ $# -ge 2 ] || usage_error '--browser requires a value'; set_browser "$2"; shift 2 ;;
      --background) BACKGROUND=1; shift ;;
      --foreground) FOREGROUND=1; shift ;;
      --trusted) TRUSTED=1; shift ;;
      --json) JSON=1; shift ;;
      --include-links) INCLUDE_LINKS=1; shift ;;
      --tab) [ $# -ge 2 ] || usage_error '--tab requires a value'; TAB="$2"; shift 2 ;;
      --timeout) [ $# -ge 2 ] || usage_error '--timeout requires a value'; TIMEOUT="$2"; TIMEOUT_SET=1; shift 2 ;;
      --selector) [ $# -ge 2 ] || usage_error '--selector requires a value'; SELECTOR="$2"; SELECTOR_SET=1; shift 2 ;;
      --wait-for-selector) [ $# -ge 2 ] || usage_error '--wait-for-selector requires a value'; WAIT_SELECTOR="$2"; WAIT_SELECTOR_SET=1; shift 2 ;;
      --out) [ $# -ge 2 ] || usage_error '--out requires a value'; OUT="$2"; OUT_SET=1; shift 2 ;;
      --to) [ $# -ge 2 ] || usage_error '--to requires a value'; TO="$2"; TO_SET=1; shift 2 ;;
      --by) [ $# -ge 2 ] || usage_error '--by requires a value'; BY="$2"; BY_SET=1; shift 2 ;;
      --max-chars) [ $# -ge 2 ] || usage_error '--max-chars requires a value'; MAX_CHARS="$2"; MAX_CHARS_SET=1; shift 2 ;;
      --raw) RAW=1; shift ;;
      --) shift; ARGS+=("$@"); break ;;
      --*) usage_error "unknown option: $1" ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
}

set_browser() {
  case "$1" in
    safari|chrome) BROWSER="$1" ;;
    *) printf 'browser-cli: invalid --browser: %s (expected safari or chrome)\n' "$1" >&2; exit 2 ;;
  esac
}

permission_blocked() {
  grep -Eq -- "$JS_PERMISSION_ERROR" "$WORK/err"
}

# ---- AppleScript runner with a timeout; stderr hints for the common failure ----
# Usage: osa <timeout> <script-file> [args...]; prints stdout, returns the exit status.
osa() {
  local limit="$1" script="$2"; shift 2
  local err="$WORK/err" rc=0
  rm -f "$WORK/timed-out"
  osascript "$script" "$@" 2>"$err" &
  local pid=$!
  ( trap 'kill "$sleeper" 2>/dev/null || true; wait "$sleeper" 2>/dev/null || true; exit' TERM INT
    sleep "$limit" & sleeper=$!
    wait "$sleeper"
    touch "$WORK/timed-out"
    kill "$pid" 2>/dev/null || true
  ) >/dev/null 2>&1 &
  local watcher=$!
  wait "$pid" || rc=$?
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  if [ "$rc" -ne 0 ]; then
    if [ -e "$WORK/timed-out" ]; then
      echo "browser-cli: timed out after ${limit}s" >&2
      [ "${BROWSER_CLI_MCP:-}" != 1 ] || return 24
    elif [ "${BROWSER_CLI_MCP:-}" = 1 ] && grep -Eq '\(-1728\)$' "$err"; then
      cat "$err" >&2
      return 26
    elif permission_blocked; then
      echo "$JS_PERMISSION_MESSAGE" >&2
      [ "${BROWSER_CLI_MCP:-}" != 1 ] || return 25
    else
      local message code
      message="$(sed -E 's/^[^ ]*: //; s/^execution error: //' "$err")"
      code=unknown
      if [[ "$message" =~ \((-?[0-9]+)\)$ ]]; then
        code="${BASH_REMATCH[1]}"
        message="${message% (*}"
      fi
      if [ "$TRUSTED" = 1 ] && [[ "$message" == *"the target "*" tab is no longer in front"* || "$message" == *"the target tab was closed or changed"* ]]; then
        # Our own guard fired: report it plainly, without the AppleScript wrapper.
        message="${message#*Error: }"; message="${message#Error: }"
        printf 'browser-cli: %s\n' "$message" >&2
      elif [ "$TRUSTED" = 1 ] && [ "$TRUSTED_SENDING" = 1 ] && { [ "$code" = -1719 ] || [ "$code" = -1728 ]; }; then
        # The window or tab disappeared while input was being sent (macOS words this per locale).
        printf 'browser-cli: the target tab was closed or changed during the action; nothing more was sent\n' >&2
      else
        printf 'browser-cli: AppleScript error %s: %s\n' "$code" "$message" >&2
      fi
    fi
  fi
  [ "$rc" -eq 0 ] || return 1
}

script() { cat >"$WORK/$1.applescript"; echo "$WORK/$1.applescript"; }

# Only these AppleScript fragments differ. Both apps support URL of tab, close tab,
# and indexed windows/tabs; their application name is also their process name.
browser_setup() {
  case "$BROWSER" in
    safari)
      APP=Safari
      AS_ACTIVE_INDEX='index of current tab of window 1'
      AS_TITLE=name
      AS_TAB_ID_JSON='"null"'
      AS_SELECT_TAB='set current tab of window w to tab t of window w'
      AS_NEW_WINDOW='make new document with properties {URL:u}'
      AS_APPEND_TAB='tell window 1
      set prev to current tab
      set newTab to make new tab with properties {URL:u}
      if bg then
        set current tab to prev
      else
        set current tab to newTab
      end if
    end tell'
      AS_JS='do JavaScript JS_CODE in TAB_REF'
      AS_WINDOW_ID='((item 3 of argv) as integer)'
      AS_SCREENSHOT_DISPLAYED='miniaturized of w or (index of current tab of w) is not (item 2 of r)'
      JS_PERMISSION_ERROR='Allow JavaScript from Apple Events'
      JS_PERMISSION_MESSAGE='browser-cli: JavaScript from Apple Events is off. Turn it on in Safari > Settings > Developer > "Allow JavaScript from Apple Events" (needs Touch ID or a password).'
      ;;
    chrome)
      APP='Google Chrome'
      AS_ACTIVE_INDEX='active tab index of window 1'
      AS_TITLE=title
      AS_TAB_ID_JSON='("\"" & (id of tab t of window w as text) & "\"")'
      AS_SELECT_TAB='set active tab index of window w to t'
      AS_NEW_WINDOW='set newWindow to make new window
    set URL of active tab of newWindow to u'
      AS_APPEND_TAB='make new tab at end of tabs of window 1 with properties {URL:u}'
      AS_JS='execute TAB_REF javascript JS_CODE'
      AS_WINDOW_ID='(item 3 of argv)'
      AS_SCREENSHOT_DISPLAYED='minimized of w or (active tab index of w) is not (item 2 of r)'
      # Chrome localizes the error text, but embeds the same help URL.
      JS_PERMISSION_ERROR='Allow JavaScript from Apple Events|support\.google\.com/chrome/\?p=applescript'
      JS_PERMISSION_MESSAGE='browser-cli: JavaScript from Apple Events is off in Chrome. Enable View > Developer > Allow JavaScript from Apple Events.'
      ;;
  esac
  RESOLVE="$(resolve_handler)"
}

# Shared handler: resolve a tab spec to {window index, tab index, URL substring or empty}.
resolve_handler() {
  if [ "$cmd" = read-page ] && [ "$BROWSER" = safari ]; then
    cat <<'AS'
on resolve(spec)
  set matched to {}
  tell application "Safari"
    considering case
      repeat with w from 1 to count of windows
        repeat with t from 1 to count of tabs of window w
          set u to URL of tab t of window w
          if u is not missing value and u contains spec then
            if matched is not {} then return {-2, 0}
            set matched to {w as integer, t as integer}
          end if
        end repeat
      end repeat
    end considering
  end tell
  if matched is {} then return {-1, 0}
  return matched
end resolve
AS
    return
  fi
  local resolve_id=''
  if [ "$BROWSER" = chrome ]; then
    resolve_id='  considering case
    set byID to spec starts with "id:"
  end considering
  if byID then
    set wantedID to text 4 thru -1 of spec
    tell application "Google Chrome"
      repeat with w from 1 to count of windows
        set tabIDs to id of every tab of window w
        repeat with t from 1 to count of tabIDs
          if item t of tabIDs is wantedID then return {w, t, ""}
        end repeat
      end repeat
    end tell
    my noTabMatch(spec)
  end if'
  fi
  cat <<AS
on resolve(spec)
$resolve_id
  tell application "$APP"
    if (count of windows) = 0 then error "no $APP window is open; open the target page in $APP first"
    if spec is "" then return {1, $AS_ACTIVE_INDEX, ""}
  end tell
  try
    set AppleScript's text item delimiters to ":"
    set parts to text items of spec
    set AppleScript's text item delimiters to ""
    if (count of parts) = 2 then
      set wi to (item 1 of parts) as integer
      set ti to (item 2 of parts) as integer
      tell application "$APP"
        if wi > 0 and wi ≤ (count of windows) then
          if ti > 0 and ti ≤ (count of tabs of window wi) then return {wi, ti, ""}
        end if
      end tell
    end if
  end try
  set AppleScript's text item delimiters to ""
  tell application "$APP"
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        if URL of tab t of window w contains spec then return {w, t, spec}
      end repeat
    end repeat
  end tell
  my noTabMatch(spec)
end resolve

on noTabMatch(spec)
  error "no tab matches: " & spec & "; run tabs to list open tabs"
end noTabMatch
AS
}

# Substitute only trusted source fragments, never caller-supplied values.
as_js() {
  local statement="${AS_JS/JS_CODE/$1}"
  printf '%s' "${statement/TAB_REF/$2}"
}

cmd_tabs() {
  [ ${#ARGS[@]} -eq 0 ] || usage_error 'tabs takes no positional arguments'
  if [ "${BROWSER_CLI_MCP:-}" = 1 ] && ! pgrep -qx "$APP"; then
    printf '[]\n'
    return
  fi
  local f; f="$(script tabs <<AS
on run argv
  set jsonOutput to item 1 of argv is "1"
  set out to ""
  tell application "$APP"
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        set u to URL of tab t of window w
        if u is missing value then set u to ""
        set tabTitle to $AS_TITLE of tab t of window w
        if tabTitle is missing value then set tabTitle to ""
        if jsonOutput then
          if out is not "" then set out to out & ","
          set out to out & "{\"window\":" & w & ",\"tab\":" & t & ",\"title\":\"" & my jsonEscape(tabTitle) & "\",\"url\":\"" & my jsonEscape(u) & "\",\"id\":" & $AS_TAB_ID_JSON & "}"
        else
          set out to out & w & ":" & t & (ASCII character 9) & my cleanField(tabTitle) & (ASCII character 9) & my cleanField(u) & linefeed
        end if
      end repeat
    end repeat
  end tell
  if jsonOutput then return "[" & out & "]"
  if out is not "" then return text 1 thru -2 of out
  return ""
end run

on cleanField(valueText)
  set resultText to ""
  repeat with c in characters of valueText
    if c is tab or c is return or c is linefeed then
      set resultText to resultText & " "
    else
      set resultText to resultText & c
    end if
  end repeat
  return resultText
end cleanField

on jsonEscape(valueText)
  set resultText to ""
  set hexDigits to "0123456789abcdef"
  set slash to ASCII character 92
  repeat with c in characters of valueText
    set n to id of c
    if n < 32 then
      set resultText to resultText & slash & "u00" & character ((n div 16) + 1) of hexDigits & character ((n mod 16) + 1) of hexDigits
    else if n is 34 or n is 92 then
      set resultText to resultText & slash & c
    else
      set resultText to resultText & c
    end if
  end repeat
  return resultText
end jsonEscape
AS
)"
  osa "$TIMEOUT" "$f" "$JSON"
}

chrome_background() {
  local python helper
  python="$(command -v python3)" || die 'Chrome background mode requires Python 3'
  helper="$(cd -- "$(dirname -- "$0")" && pwd -P)/chrome-background/bridge.py"
  if [ "$1" != install ] && [ ! -f "$helper" ]; then
    helper="$HOME/Library/Application Support/browser-cli/chrome-background/bridge.py"
  fi
  [ -f "$helper" ] || die 'Chrome background mode requires the browser-cli extension. Keep chrome-background/ beside browser-cli, get approval before setup, then run browser-cli --browser chrome install-background.'
  BROWSER_CLI_PATH="$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")" "$python" "$helper" "$@"
}

cmd_install_background() {
  [ "$BROWSER" = chrome ] || usage_error 'install-background requires --browser chrome'
  if [ "$#" -eq 1 ] && [ "$1" = --check ]; then
    chrome_background check
    return
  fi
  if [ "$#" -eq 2 ] && [ "$1" = --profile ] && [[ "$2" != --* ]] && [ -n "$2" ]; then
    chrome_background install "$2"
    return
  fi
  [ "$#" -eq 0 ] || usage_error 'install-background accepts --check or --profile DIRECTORY'
  chrome_background install
}

cmd_uninstall_background() {
  [ "$BROWSER" = chrome ] || usage_error 'uninstall-background requires --browser chrome'
  [ "$#" -eq 0 ] || usage_error 'uninstall-background takes no options or arguments'
  chrome_background uninstall
}

cmd_open() {
  [ ${#ARGS[@]} -eq 1 ] || usage_error 'open requires exactly one URL'
  if [ "$BROWSER" = chrome ] && [ "$BACKGROUND" = 1 ]; then
    chrome_background open "${ARGS[0]}" "$TIMEOUT"
    return
  fi
  if [ "$BACKGROUND" = 1 ] && ! pgrep -qx "$APP"; then
    open -g -a "$APP" || die "cannot launch $APP"
  fi
  local f; f="$(script open <<AS
on run argv
  set u to item 1 of argv
  set bg to (item 2 of argv) is "1"
  tell application "$APP"
    if not bg then activate
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        set tu to URL of tab t of window w
        if tu is not missing value and tu starts with u then
          if bg then return (w as text) & ":" & t & (ASCII character 9) & "reused"
          $AS_SELECT_TAB
          set index of window w to 1
          return "1:" & t & (ASCII character 9) & "reused"
        end if
      end repeat
    end repeat
    if (count of windows) = 0 or (count of tabs of window 1) = 0 then
      $AS_NEW_WINDOW
      return "1:1" & (ASCII character 9) & "created"
    end if
    $AS_APPEND_TAB
    return "1:" & (count of tabs of window 1) & (ASCII character 9) & "created"
  end tell
end run
AS
)"
  osa "$TIMEOUT" "$f" "${ARGS[0]}" "$BACKGROUND"
}

cmd_close() {
  [ ${#ARGS[@]} -eq 0 ] || usage_error 'close takes no positional arguments; use --tab to select a tab'
  local f; f="$(script close <<AS
on run argv
  set r to resolve(item 1 of argv)
  tell application "$APP" to close tab (item 2 of r) of window (item 1 of r)
  return ""
end run
$RESOLVE
AS
)"
  osa "$TIMEOUT" "$f" "$TAB"
}

# Share the normalization with the AppleScript recheck: BSD ps pads lstart with spaces.
CHROME_START_COMMAND='LC_ALL=C TZ=UTC0 /bin/ps -p '
CHROME_TRIM='s/^[[:space:]]*//;s/[[:space:]]*$//'
CHROME_START_SUFFIX=" -o lstart= | /usr/bin/sed '$CHROME_TRIM'"

# Only trust a single Chrome process. Include its start time because PIDs are reusable.
chrome_instance() {
  local pid started
  pid="$(pgrep -x 'Google Chrome')" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  started="$(LC_ALL=C TZ=UTC0 ps -p "$pid" -o lstart= | /usr/bin/sed "$CHROME_TRIM")" || return 1
  [ -n "$started" ] && [[ "$started" != *$'\n'* && "$started" != *$'\r'* && "$started" != *$'\t'* ]] || return 1
  printf '%s\t%s\n' "$pid" "$started"
}

cmd_chrome_instance() {
  [ "$BROWSER" = chrome ] || usage_error 'chrome-instance requires --browser chrome'
  [ ${#ARGS[@]} -eq 0 ] && [ -z "$TAB" ] || usage_error 'chrome-instance takes no arguments or tab'
  chrome_instance || printf 'unknown\n'
}

# Internal cleanup only. The MCP reader must supply a tab ID it recorded as created.
cmd_close_created() {
  [ "$BROWSER" = chrome ] || usage_error 'close-created requires --browser chrome'
  [ ${#ARGS[@]} -eq 1 ] && [[ "$TAB" = id:* ]] && [ -n "${ARGS[0]}" ] ||
    usage_error 'close-created requires --tab id:<id> -- <expected-instance>'
  local instance
  if ! instance="$(chrome_instance)" || [ "$instance" != "${ARGS[0]}" ]; then
    printf 'instance_changed\n'
    return 0
  fi
  # Bash 3.2 misparses this quoted heredoc inside a command substitution.
  local f="$WORK/close-created.applescript"
  cat >"$f" <<'AS'
on run argv
  set wantedID to item 1 of argv
  set expectedInstance to item 2 of argv
  if application "Google Chrome" is not running then return "instance_changed"
  tell application "Google Chrome"
    -- Chrome's AppleScript tab IDs are text.
    set windowIDs to id of every window
    repeat with w in windowIDs
      set wi to contents of w
      set tabIDs to id of every tab of window id wi
      if tabIDs contains wantedID then
        -- Verify the browser instance again before sending the close event.
        if my chromeInstance(item 3 of argv, item 4 of argv) is not expectedInstance then return "instance_changed"
        close tab id wantedID of window id wi
        return "closed"
      end if
    end repeat
  end tell
  if my chromeInstance(item 3 of argv, item 4 of argv) is not expectedInstance then return "instance_changed"
  return "not_found"
end run

on chromeInstance(startCommand, startSuffix)
  try
    set p to do shell script "/usr/bin/pgrep -x 'Google Chrome'"
    if (count of paragraphs of p) is not 1 then return ""
    set started to do shell script (startCommand & quoted form of p & startSuffix)
    if started is "" or (count of paragraphs of started) is not 1 or started contains (ASCII character 9) then return ""
    return p & (ASCII character 9) & started
  on error
    return ""
  end try
end chromeInstance
AS
  osa "$TIMEOUT" "$f" "${TAB#id:}" "$instance" "$CHROME_START_COMMAND" "$CHROME_START_SUFFIX"
}

# Runs the expression in the tab; prints the value, exits 1 on a JS exception.
# Assign a JavaScript string literal to JS_STRING without losing trailing newlines.
js_string() {
  local s="$1" c n i
  JS_STRING='"'
  for ((i=0; i<${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      '"') JS_STRING+='\"' ;;
      '\') JS_STRING+='\\' ;;
      *) printf -v n '%d' "'$c"; if [ "$n" -ge 0 ] && [ "$n" -lt 32 ]; then printf -v c '\\u%04x' "$n"; fi; JS_STRING+="$c" ;;
    esac
  done
  JS_STRING+='"'
}

run_js() {
  local direct=0
  if [ "$1" = --direct ]; then
    direct=1
    shift
  fi
  local code="$1" limit="$2"
  local guarded=''
  if [ "$cmd" = read-page ]; then
    guarded='  if item 1 of r is -2 then return "ok:{\"status\":\"tab_ambiguous\"}"
  if item 1 of r is -1 then return "ok:{\"status\":\"target_changed\"}"'
  fi
  local target_ref='tab (item 2 of r) of window (item 1 of r)'
  if [ "$cmd" = read-page ] && [ "$BROWSER" = chrome ]; then
    target_ref='tab id (text 4 thru -1 of (item 1 of argv)) of window (item 1 of r)'
  fi
  local trusted_tab_ref="tab ((item 1 of argv) as integer) of window id $AS_WINDOW_ID"
  if [ -n "${5-}" ]; then
    trusted_tab_ref='tab id (item 1 of argv) of window id (item 3 of argv)'
  fi
  # Fixed expressions can run directly even when the page disallows string eval.
  # Trusted actions also supply a stable window ID and, on Chrome, a tab ID.
