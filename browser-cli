cmd_trusted() {
  local selector="$1" arg="$2" f target window_id tab_index tab_id code result point='' output=''
  if [ "$cmd" = press ]; then
    local LC_ALL=C
    local printable='^[ -~]$'
    case "$arg" in
      Enter|Escape|Tab|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|Backspace|Space) ;;
      *) [[ "$arg" =~ $printable ]] || die "unsupported trusted key: $arg (use a named key or printable ASCII character)" ;;
    esac
