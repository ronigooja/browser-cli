  local selector="$SELECTOR" code
  selector="${selector//\\/\\\\}"
  selector="${selector//\"/\\\"}"
  selector="${selector//$'\n'/\\n}"
  selector="${selector//$'\r'/\\r}"
  selector="${selector//$'\t'/\\t}"
  code="(function(){ var root = $([ "$SELECTOR_SET" = 1 ] && printf 'document.querySelector("%s")' "$selector" || printf 'document.documentElement');"
  cat >"$WORK/snapshot.js" <<'JS'
    if (!root) return 'browser-cli-no-match:';
    var query = 'a,button,input:not([type="hidden"]),select,textarea,summary,[role="button"],[role="link"],[role="checkbox"],[role="tab"],[role="menuitem"],[role="switch"],[role="option"],[role="combobox"],[role="textbox"],[contenteditable],[onclick],[tabindex]';
