    frontWindow();
    se.keystroke('a', {using: 'command down'});
    if (text === '') se.keyCode(51);
    else paste(se, text, frontWindow);
  } else if (action === 'press') {
    frontWindow();
    if (Object.prototype.hasOwnProperty.call(codes, text)) se.keyCode(codes[text]);
    else se.keystroke(text);
  }
