      if (e.matches('[tabindex]') && !e.matches('a,button,input:not([type="hidden"]),select,textarea,summary,[role="button"],[role="link"],[role="checkbox"],[role="tab"],[role="menuitem"],[role="switch"],[role="option"],[role="combobox"],[role="textbox"],[contenteditable],[onclick]') && e.tabIndex < 0) return;
