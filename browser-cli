cmd_read_page() {
  [ ${#ARGS[@]} -eq 1 ] || usage_error 'read-page requires an exact URL'
  [[ "${ARGS[0]}" =~ ^https?:// ]] || usage_error 'read-page requires an HTTP(S) URL'
  if [ "$BROWSER" = chrome ]; then
    [[ "$TAB" = id:* ]] || usage_error 'read-page requires --tab id:<id> in Chrome'
  else
    [ -n "$TAB" ] || usage_error 'read-page requires a --tab URL substring in Safari'
  fi
  js_string "${ARGS[0]}"
  local expected="$JS_STRING" selector wait_selector code
  js_string "$SELECTOR"; selector="$JS_STRING"
  js_string "$WAIT_SELECTOR"; wait_selector="$JS_STRING"
  code="(function(){ $CHALLENGE_JS $LOGIN_GATE_JS
    if (location.href !== $expected) return {status:'target_changed', document_url:location.href};
    var challenge = challengeState();
    if (challenge === 'needs-human') return {status:'verification_required'};
    if (challenge === 'cloudflare-passive') return {status:'passive_challenge'};
    function visible(e) {
      var s = getComputedStyle(e), r = e.getBoundingClientRect();
      if (s.visibility !== 'visible' || r.width <= 0 || r.height <= 0 || e.closest('[hidden],[aria-hidden=\"true\"]')) return false;
