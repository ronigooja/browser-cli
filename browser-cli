    [ "$SECONDS" -ge "$deadline" ] || sleep 0.1
  done
}

cmd_wait_challenge() {
  [ ${#ARGS[@]} -eq 0 ] || usage_error 'wait-challenge takes no positional arguments'
  [ "$TIMEOUT_SET" = 1 ] || TIMEOUT=600
  local deadline=$((SECONDS + TIMEOUT)) remaining out state=unknown host last_error=""
  while :; do
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      if [ "$state" = cloudflare-passive ]; then
        die "passive challenge still detected after ${TIMEOUT}s"
      fi
      [ -z "$last_error" ] || printf '%s\n' "$last_error" >&2
      die "could not determine challenge state within ${TIMEOUT}s"
    fi
    if out="$(run_js --direct "(function(){ $CHALLENGE_JS return challengeState() + '\\n' + (location.host || location.protocol); })()" "$remaining" 2>"$WORK/challenge-error")"; then
      state="${out%%$'\n'*}"
      host="${out#*$'\n'}"
      if [ "$state" = none ]; then
        echo 'challenge: none'
        return 0
      fi
      if [ "$state" = needs-human ]; then
        # Pass the host and browser as arguments, not interpolated AppleScript source.
        osascript -e 'on run argv' -e 'display notification ((item 1 of argv) & " needs verification — please complete it in " & (item 2 of argv)) with title "browser-cli"' -e 'end run' "$host" "$APP" >/dev/null 2>&1 || true
        die "human verification needed on $host; complete it in $APP, then run wait-challenge again"
      fi
      last_error=""
    else
      state=unknown
      last_error="$(cat "$WORK/challenge-error")"
      if grep -q 'JavaScript from Apple Events is off' "$WORK/challenge-error"; then
        printf '%s\n' "$last_error" >&2
        return 1
      fi
    fi
    [ "$SECONDS" -ge "$deadline" ] || sleep 1
  done
}

cmd_status() {
  [ ${#ARGS[@]} -eq 0 ] || usage_error 'status takes no positional arguments'
  local f state mcp_guard='' rc
  if [ "${BROWSER_CLI_MCP:-}" = 1 ]; then
    if ! pgrep -qx "$APP"; then
      printf 'unknown\n'
      return 0
    fi
    mcp_guard="  if application \"$APP\" is not running then return \"unknown\""
  fi
  f="$(script status <<AS
on run
$mcp_guard
  tell application "$APP"
    if (count of windows) = 0 then return "unknown"
    repeat with w from 1 to count of windows
      if (count of tabs of window w) > 0 then
        $(as_js '"1+1"' 'tab 1 of window w')
        return "on"
      end if
    end repeat
    return "unknown"
  end tell
end run
AS
)"
  if osa "$TIMEOUT" "$f" >"$WORK/status"; then
    state="$(cat "$WORK/status")"
    cat "$WORK/status"
    if [ "$state" = unknown ]; then
      [ "${BROWSER_CLI_MCP:-}" != 1 ] || return 0
      printf 'browser-cli: no tab is open in %s; open a page in %s, then check status again\n' "$APP" "$APP" >&2
    fi
    [ "$state" = on ]
  else
    rc=$?
    if [ "$rc" = 25 ] || { [ "${BROWSER_CLI_MCP:-}" != 1 ] && permission_blocked; }; then
      echo off
    fi
    return "$rc"
  fi
}

while [ "${1-}" = --browser ]; do
  [ $# -ge 2 ] || usage_error '--browser requires a value'
  set_browser "$2"; shift 2
done
[ $# -ge 1 ] || usage_error 'missing command'
cmd="$1"; shift
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) echo "$VERSION" ;;
  mcp) usage_error 'mcp takes no options or arguments' ;;
  install-background) cmd_install_background "$@" ;;
  uninstall-background) cmd_uninstall_background "$@" ;;
  tabs|open|close|close-created|chrome-instance|eval|file|wait|wait-challenge|status|info|read-page|text|links|html|snapshot|screenshot|click|fill|select|press|scroll|submit)
    if [[ "$cmd" = close-created || "$cmd" = chrome-instance ]] && [ "${BROWSER_CLI_MCP:-}" != 1 ]; then
      usage_error "unknown command: $cmd"
    fi
    parse "$@"
    [ -n "$BROWSER" ] || { echo 'browser-cli: --browser safari|chrome is required' >&2; exit 2; }
    if [[ "$TAB" = id:* ]] && { [ "$cmd" != read-page ] || [ "$BROWSER" != safari ]; }; then
      [ "$BROWSER" = chrome ] || { echo 'browser-cli: --tab id:<id> is only supported for chrome' >&2; exit 2; }
      [[ "${TAB#id:}" =~ ^[0-9]+$ ]] || { echo 'browser-cli: --tab id:<id> needs a numeric tab id' >&2; exit 2; }
    fi
    [[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo 'browser-cli: timeout must be a positive integer' >&2; exit 2; }
    [ "$FOREGROUND$BACKGROUND" != 11 ] || { echo 'browser-cli: --foreground and --background cannot be used together' >&2; exit 2; }
    [ "$TRUSTED$BACKGROUND" != 11 ] || { echo 'browser-cli: --trusted cannot be used with --background' >&2; exit 2; }
    [ "$TRUSTED" = 0 ] || [[ "$cmd" =~ ^(click|fill|press)$ ]] || { echo 'browser-cli: --trusted only applies to click, fill, and press' >&2; exit 2; }
    [ "$BACKGROUND" = 0 ] || [ "$cmd" = open ] || { echo 'browser-cli: --background only applies to open' >&2; exit 2; }
    [ "$FOREGROUND" = 0 ] || [ "$cmd" = open ] || { echo 'browser-cli: --foreground only applies to open' >&2; exit 2; }
    [ "$cmd" != open ] || [ "$FOREGROUND$BACKGROUND" != 00 ] || { echo 'browser-cli: open needs --foreground or --background' >&2; exit 2; }
    [ "$JSON" = 0 ] || [ "$cmd" = tabs ] || { echo 'browser-cli: --json only applies to tabs' >&2; exit 2; }
    [ "$INCLUDE_LINKS" = 0 ] || [ "$cmd" = read-page ] || usage_error '--include-links only applies to read-page'
    [ "$WAIT_SELECTOR_SET" = 0 ] || [ "$cmd" = read-page ] || usage_error '--wait-for-selector only applies to read-page'
    [ "$SELECTOR_SET" = 0 ] || [[ "$cmd" =~ ^(read-page|text|links|html|snapshot|screenshot|press|scroll)$ ]] || { echo 'browser-cli: --selector only applies to read-page, text, links, html, snapshot, screenshot, press, and scroll' >&2; exit 2; }
    [ "$OUT_SET" = 0 ] || [ "$cmd" = screenshot ] || { echo 'browser-cli: --out only applies to screenshot' >&2; exit 2; }
    if [ "$cmd" = scroll ]; then
      [ "$((TO_SET + BY_SET))" = 1 ] || { echo 'browser-cli: scroll requires exactly one of --to or --by' >&2; exit 2; }
      [ "$TO_SET" = 0 ] || [[ "$TO" =~ ^(top|bottom)$ ]] || { echo 'browser-cli: --to must be top or bottom' >&2; exit 2; }
      [ "$BY_SET" = 0 ] || [[ "$BY" =~ ^-?[0-9]+$ ]] || { echo 'browser-cli: --by must be an integer' >&2; exit 2; }
    else
      [ "$((TO_SET + BY_SET))" = 0 ] || { echo 'browser-cli: --to and --by only apply to scroll' >&2; exit 2; }
    fi
    [ "$RAW" = 0 ] || [ "$cmd" = html ] || { echo 'browser-cli: --raw only applies to html' >&2; exit 2; }
    if [ "$MAX_CHARS_SET" = 1 ]; then
      [[ "$MAX_CHARS" =~ ^[1-9][0-9]*$ ]] || { echo 'browser-cli: max-chars must be a positive integer' >&2; exit 2; }
      [[ "$cmd" =~ ^(text|links|html|snapshot|eval|file)$ ]] || { echo 'browser-cli: --max-chars only applies to text, links, html, snapshot, eval, and file' >&2; exit 2; }
    fi
    browser_setup
    case "$cmd" in
      text|links|html) cmd_read ;;
      click|fill|select|press|scroll|submit) cmd_action ;;
      *) "cmd_${cmd//-/_}" ;;
    esac
    ;;
  *) usage_error "unknown command: $cmd" ;;
esac
