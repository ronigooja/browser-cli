  f="$WORK/trusted.js"
  cat >"$f" <<'JS'
ObjC.import('ApplicationServices');
ObjC.import('AppKit');
function run(argv) {
  const se = Application('System Events');
  if (argv[0] === 'permission') return $.AXIsProcessTrusted() && se.uiElementsEnabled();
  const [action, windowID, tabIndex, geometry, text, appName, tabID] = argv;
  const GONE = 'the target tab was closed or changed during the action; nothing more was sent';
  const codes = {Enter: 36, Escape: 53, Tab: 48, ArrowUp: 126, ArrowDown: 125,
                 ArrowLeft: 123, ArrowRight: 124, Backspace: 51, Space: 49, ' ': 49};
  const app = Application(appName);
  const process = se.processes.byName(appName);
  const chrome = appName === 'Google Chrome';
  const browser = chrome ? 'Chrome' : 'Safari';
  // Safari tabs have no id, so a URL+title fingerprint stands in: if the target tab is closed and a
  // neighbour slides into its index, the fingerprint differs and nothing is sent to the neighbour.
  function fingerprint(win) {
    const tab = win.currentTab;
    return String(tab.url()) + '\n' + String(tab.name());
  }
  function frontWindow() {
    let inFront;
    try {
      const win = app.windows[0];
      inFront = chrome
        ? win.id() === windowID && String(win.activeTab.id()) === tabID && process.frontmost()
        : process.frontmost() && win.id() === Number(windowID) && win.currentTab.index() === Number(tabIndex) && fingerprint(win) === tabID;
      if (inFront) return win;
    } catch (_) {
      // The window or tab vanished while it was being read.
      throw new Error(GONE);
    }
    throw new Error(process.frontmost() ? GONE : 'the target ' + browser + ' tab is no longer in front; nothing more was sent');
  }

  const win = frontWindow();
  if (geometry) {
    const [x, y, sx, sy, ow, oh, iw, ih, zoom] = JSON.parse(geometry);
    const bounds = win.bounds();
    // Chrome's zoom bubble and other transient windows can precede the actual
    // browser window in System Events, even while the browser window is main.
    const axWindow = chrome ? chromeMainWindow(process) : process.windows[0];
    const [wx, wy] = axWindow.position();
    const [ww, wh] = axWindow.size();
    const web = chrome ? chromeViewport(axWindow, [wx, wy, ww, wh], iw, ih) : webViewport(axWindow, 0);
    if (!web || Math.abs(wx - bounds.x) > 2 || Math.abs(wy - bounds.y) > 2 ||
        Math.abs(ww - bounds.width) > 2 || Math.abs(wh - bounds.height) > 2 ||
        Math.abs(sx - wx) > 2 || Math.abs(sy - wy) > 2 ||
        Math.abs(ow - ww) > 2 || Math.abs(oh - wh) > 2)
      throw new Error('could not verify ' + browser + ' viewport position');
    const [[vx, vy], [vw, vh]] = web;
    // AX measures the actual content area, including the toolbar/sidebar insets
    // from the window bounds. The width ratio converts CSS px (page zoom) to
    // screen points; comparing the height also checks the toolbar calibration.
    const scale = vw / iw;
    if (!(scale > 0 && zoom > 0 && Math.abs(ih * scale - vh) <= 3 &&
          vx >= wx - 2 && vy >= wy - 2 && vx + vw <= wx + ww + 2 && vy + vh <= wy + wh + 2))
      throw new Error('could not calibrate ' + browser + ' viewport dimensions');
    const px = vx + x * scale * zoom, py = vy + y * scale * zoom;
    if (!(px >= vx && px < vx + vw && py >= vy && py < vy + vh && onScreen(px, py)))
      throw new Error('element center is outside the visible ' + browser + ' viewport; scroll to it first');
    const current = frontWindow();
    if (chrome) {
      const b = current.bounds();
      if (b.x !== bounds.x || b.y !== bounds.y || b.width !== bounds.width || b.height !== bounds.height)
        throw new Error('Chrome window moved or resized during viewport calibration');
      checkChromeWindowAtPoint(process, px, py);
      frontWindow();
    }
    const point = $.CGPointMake(px, py);
    [$.kCGEventMouseMoved, $.kCGEventLeftMouseDown, $.kCGEventLeftMouseUp].forEach(type => {
      $.CGEventPost($.kCGHIDEventTap, $.CGEventCreateMouseEvent(null, type, point, $.kCGMouseButtonLeft));
    });
