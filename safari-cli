[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) echo "$VERSION" ;;
  tabs|open|close|eval|file|wait|wait-challenge|status|info|text|links|html|snapshot|screenshot|click|fill|select|press|scroll|submit)
    parse "$@"
    [[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo 'safari-cli: timeout must be a positive integer' >&2; exit 2; }
    [ "$TRUSTED$BACKGROUND" != 11 ] || { echo 'safari-cli: --trusted cannot be used with --background' >&2; exit 2; }
    [ "$TRUSTED" = 0 ] || [[ "$cmd" =~ ^(click|fill|press)$ ]] || { echo 'safari-cli: --trusted only applies to click, fill, and press' >&2; exit 2; }
    [ "$BACKGROUND" = 0 ] || [ "$cmd" = open ] || { echo 'safari-cli: --background only applies to open' >&2; exit 2; }
    [ "$JSON" = 0 ] || [ "$cmd" = tabs ] || { echo 'safari-cli: --json only applies to tabs' >&2; exit 2; }
    [ "$SELECTOR_SET" = 0 ] || [[ "$cmd" =~ ^(text|links|html|snapshot|screenshot|press|scroll)$ ]] || { echo 'safari-cli: --selector only applies to text, links, html, snapshot, screenshot, press, and scroll' >&2; exit 2; }
    [ "$OUT_SET" = 0 ] || [ "$cmd" = screenshot ] || { echo 'safari-cli: --out only applies to screenshot' >&2; exit 2; }
    if [ "$cmd" = scroll ]; then
      [ "$((TO_SET + BY_SET))" = 1 ] || { echo 'safari-cli: scroll requires exactly one of --to or --by' >&2; exit 2; }
      [ "$TO_SET" = 0 ] || [[ "$TO" =~ ^(top|bottom)$ ]] || { echo 'safari-cli: --to must be top or bottom' >&2; exit 2; }
      [ "$BY_SET" = 0 ] || [[ "$BY" =~ ^-?[0-9]+$ ]] || { echo 'safari-cli: --by must be an integer' >&2; exit 2; }
    else
      [ "$((TO_SET + BY_SET))" = 0 ] || { echo 'safari-cli: --to and --by only apply to scroll' >&2; exit 2; }
    fi
    [ "$RAW" = 0 ] || [ "$cmd" = html ] || { echo 'safari-cli: --raw only applies to html' >&2; exit 2; }
    if [ "$MAX_CHARS_SET" = 1 ]; then
      [[ "$MAX_CHARS" =~ ^[1-9][0-9]*$ ]] || { echo 'safari-cli: max-chars must be a positive integer' >&2; exit 2; }
      [[ "$cmd" =~ ^(text|links|html|snapshot|eval|file)$ ]] || { echo 'safari-cli: --max-chars only applies to text, links, html, snapshot, eval, and file' >&2; exit 2; }
    fi
    case "$cmd" in
      text|links|html) cmd_read ;;
      click|fill|select|press|scroll|submit) cmd_action ;;
      *) "cmd_${cmd//-/_}" ;;
    esac
