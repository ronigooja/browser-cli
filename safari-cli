cmd_wait() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  local deadline=$((SECONDS + TIMEOUT)) out remaining last_error=""
  while :; do
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      [ -z "$last_error" ] || printf '%s\n' "$last_error" >&2
      die "timed out after ${TIMEOUT}s waiting for: ${ARGS[0]}"
    fi
    if out="$(run_js "!!(
${ARGS[0]}
)" "$remaining" 2>"$WORK/wait-error")"; then
      :
    else
      last_error="$(cat "$WORK/wait-error")"
      if grep -q 'JavaScript from Apple Events is off' "$WORK/wait-error"; then
        printf '%s\n' "$last_error" >&2
        return 1
      fi
    fi
    [ "$out" = "true" ] && return 0
    [ "$SECONDS" -ge "$deadline" ] || sleep 0.1
  done
}

cmd_wait_challenge() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  [ "$TIMEOUT_SET" = 1 ] || TIMEOUT=600
  local deadline=$((SECONDS + TIMEOUT)) remaining out state=unknown host notified=0
  while :; do
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      die "challenge not cleared after ${TIMEOUT}s (state: $state)"
    fi
    if out="$(run_js "(function(){ $CHALLENGE_JS return challengeState() + '\\n' + (location.host || location.protocol); })()" "$remaining" 2>"$WORK/challenge-error")"; then
      state="${out%%$'\n'*}"
      host="${out#*$'\n'}"
      if [ "$state" = none ]; then
        echo 'challenge: cleared'
        return 0
      fi
      if [ "$state" = needs-human ] && [ "$notified" = 0 ]; then
        printf 'safari-cli: human verification needed on %s; waiting for you to complete it\n' "$host" >&2
        # Pass the host as an argument, not interpolated AppleScript source.
        osascript -e 'on run argv' -e 'display notification ((item 1 of argv) & " needs verification — please complete it in Safari") with title "safari-cli"' -e 'end run' "$host" >/dev/null 2>&1 || true
        notified=1
      fi
    elif grep -q 'JavaScript from Apple Events is off' "$WORK/challenge-error"; then
      cat "$WORK/challenge-error" >&2
      return 1
    fi
    [ "$SECONDS" -ge "$deadline" ] || sleep 1
  done
}

