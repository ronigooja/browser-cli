#!/bin/bash
# Drive the real, logged-in Safari from the shell: list/open/close tabs, run JavaScript in a tab.
# Usage: see `safari-cli help` or README.md. Needs macOS and Safari > Settings > Developer >
# "Allow JavaScript from Apple Events" enabled manually by the user.
set -euo pipefail
export LC_ALL=en_US.UTF-8

VERSION=0.1.0
DEFAULT_TIMEOUT=30

WORK="$(mktemp -d)"
cleanup() {
  local rc=$?
  trap - EXIT
  rm -rf "$WORK"
  exit "$rc"
}
trap cleanup EXIT

die() { echo "safari-cli: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
safari-cli <command> [options]

  tabs                          list tabs: <window>:<tab> <TAB> title <TAB> url
  open <url>                    focus or create a tab; prints <window>:<tab> <TAB> reused|created
  close [--tab T]               close a tab
  eval [--tab T] <js>           run a JavaScript expression, print its value (strings as is, others as JSON)
  file [--tab T] <path.js>      same, with the expression read from a file
  info [--tab T]                show page metadata and character counts
  text [--tab T]                print page text
  links [--tab T]               print link text and absolute URLs
  html [--tab T]                print sanitized page HTML
  snapshot [--tab T] [--selector CSS] [--max-chars N]  list interactive elements
  wait [--tab T] <js>           poll until the expression is truthy
  status                        probe JavaScript permission: on, off, or unknown (no window)

--tab T     <window>:<tab> as printed by `tabs`, or a substring of the URL; default: front window's current tab
--background open only: do not activate Safari, raise a window or switch tabs; launches Safari in the background if not running
--json      tabs only: output a JSON array
--timeout N positive integer seconds before commands give up (default 30)
--selector CSS scope text, links, html, or snapshot to the first matching element
--max-chars N limit output characters for text, links, html, snapshot, eval, or file
--raw       html only: return unmodified outerHTML
Enable JavaScript from Apple Events once by hand in Safari > Settings > Developer.
This tool never changes that setting and never restarts Safari.
Exit status: 0 ok, 1 error (JS exception, no matching tab, timeout), 2 usage.
EOF
}

# ---- option parsing: sets TAB, TIMEOUT and ARGS (positional) ----
TAB=""; TIMEOUT="$DEFAULT_TIMEOUT"; BACKGROUND=0; JSON=0; ARGS=()
SELECTOR=""; SELECTOR_SET=0; MAX_CHARS=""; MAX_CHARS_SET=0; RAW=0
parse() {
  ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --background) BACKGROUND=1; shift ;;
      --json) JSON=1; shift ;;
      --tab) [ $# -ge 2 ] || { usage >&2; exit 2; }; TAB="$2"; shift 2 ;;
      --timeout) [ $# -ge 2 ] || { usage >&2; exit 2; }; TIMEOUT="$2"; shift 2 ;;
      --selector) [ $# -ge 2 ] || { usage >&2; exit 2; }; SELECTOR="$2"; SELECTOR_SET=1; shift 2 ;;
      --max-chars) [ $# -ge 2 ] || { usage >&2; exit 2; }; MAX_CHARS="$2"; MAX_CHARS_SET=1; shift 2 ;;
      --raw) RAW=1; shift ;;
      --) shift; ARGS+=("$@"); break ;;
      --*) usage >&2; exit 2 ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
}

blocked_message() {
  echo 'safari-cli: JavaScript from Apple Events is off. Turn it on in Safari > Settings > Developer > "Allow JavaScript from Apple Events" (needs Touch ID or a password), then retry.' >&2
}

# ---- AppleScript runner with a timeout; stderr hints for the common failure ----
# Usage: osa <timeout> <script-file> [args...]; prints stdout, returns the exit status.
osa() {
  local limit="$1" script="$2"; shift 2
  local err="$WORK/err" rc=0
  rm -f "$WORK/timed-out"
  osascript "$script" "$@" 2>"$err" &
  local pid=$!
  ( trap 'kill "$sleeper" 2>/dev/null || true; wait "$sleeper" 2>/dev/null || true; exit' TERM INT
    sleep "$limit" & sleeper=$!
    wait "$sleeper"
    touch "$WORK/timed-out"
    kill "$pid" 2>/dev/null || true
  ) >/dev/null 2>&1 &
  local watcher=$!
  wait "$pid" || rc=$?
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  if [ "$rc" -ne 0 ]; then
    if [ -e "$WORK/timed-out" ]; then
      echo "safari-cli: timed out after ${limit}s" >&2
    elif grep -q "Allow JavaScript from Apple Events" "$err"; then
      blocked_message
    else
      local message code
      message="$(sed -E 's/^[^ ]*: //; s/^execution error: //' "$err")"
      code=unknown
      if [[ "$message" =~ \((-?[0-9]+)\)$ ]]; then
        code="${BASH_REMATCH[1]}"
        message="${message% (*}"
      fi
      printf 'safari-cli: AppleScript error %s: %s\n' "$code" "$message" >&2
    fi
  fi
  [ "$rc" -eq 0 ] || return 1
}

script() { cat >"$WORK/$1.applescript"; echo "$WORK/$1.applescript"; }

# Shared handler: resolve a tab spec to {window, tab}.
RESOLVE='
on resolve(spec)
  tell application "Safari"
    if (count of windows) = 0 then error "no Safari window is open"
    if spec is "" then return {1, index of current tab of window 1}
  end tell
  try
    set AppleScript'"'"'s text item delimiters to ":"
    set parts to text items of spec
    set AppleScript'"'"'s text item delimiters to ""
    if (count of parts) = 2 then
      set wi to (item 1 of parts) as integer
      set ti to (item 2 of parts) as integer
      tell application "Safari"
        if wi > 0 and wi ≤ (count of windows) then
          if ti > 0 and ti ≤ (count of tabs of window wi) then return {wi, ti}
        end if
      end tell
    end if
  end try
  set AppleScript'"'"'s text item delimiters to ""
  tell application "Safari"
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        if URL of tab t of window w contains spec then return {w, t}
      end repeat
    end repeat
  end tell
  error "no tab matches: " & spec
end resolve
'

cmd_tabs() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local f; f="$(script tabs <<'AS'
on run argv
  set jsonOutput to item 1 of argv is "1"
  set out to ""
  tell application "Safari"
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        set u to URL of tab t of window w
        if u is missing value then set u to ""
        set tabTitle to name of tab t of window w
        if tabTitle is missing value then set tabTitle to ""
        if jsonOutput then
          if out is not "" then set out to out & ","
          set out to out & "{\"window\":" & w & ",\"tab\":" & t & ",\"title\":\"" & my jsonEscape(tabTitle) & "\",\"url\":\"" & my jsonEscape(u) & "\"}"
        else
          set out to out & w & ":" & t & (ASCII character 9) & my cleanField(tabTitle) & (ASCII character 9) & my cleanField(u) & linefeed
        end if
      end repeat
    end repeat
  end tell
  if jsonOutput then return "[" & out & "]"
  if out is not "" then return text 1 thru -2 of out
  return ""
end run

on cleanField(valueText)
  set resultText to ""
  repeat with c in characters of valueText
    if c is tab or c is return or c is linefeed then
      set resultText to resultText & " "
    else
      set resultText to resultText & c
    end if
  end repeat
  return resultText
end cleanField

on jsonEscape(valueText)
  set resultText to ""
  set hexDigits to "0123456789abcdef"
  set slash to ASCII character 92
  repeat with c in characters of valueText
    set n to id of c
    if n < 32 then
      set resultText to resultText & slash & "u00" & character ((n div 16) + 1) of hexDigits & character ((n mod 16) + 1) of hexDigits
    else if n is 34 or n is 92 then
      set resultText to resultText & slash & c
    else
      set resultText to resultText & c
    end if
  end repeat
  return resultText
end jsonEscape
AS
)"
  osa "$TIMEOUT" "$f" "$JSON"
}

cmd_open() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  if [ "$BACKGROUND" = 1 ] && ! pgrep -qx Safari; then
    open -g -a Safari || die "cannot launch Safari"
  fi
  local f; f="$(script open <<'AS'
on run argv
  set u to item 1 of argv
  set bg to (item 2 of argv) is "1"
  tell application "Safari"
    if not bg then activate
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        set tu to URL of tab t of window w
        if tu is not missing value and tu starts with u then
          if bg then return (w as text) & ":" & t & (ASCII character 9) & "reused"
          set current tab of window w to tab t of window w
          set index of window w to 1
          return "1:" & t & (ASCII character 9) & "reused"
        end if
      end repeat
    end repeat
    if (count of windows) = 0 then
      make new document with properties {URL:u}
      return "1:1" & (ASCII character 9) & "created"
    end if
    tell window 1
      set prev to current tab
      set newTab to make new tab with properties {URL:u}
      if bg then
        set current tab to prev
      else
        set current tab to newTab
      end if
    end tell
    return "1:" & (count of tabs of window 1) & (ASCII character 9) & "created"
  end tell
end run
AS
)"
  osa "$TIMEOUT" "$f" "${ARGS[0]}" "$BACKGROUND"
}

cmd_close() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local f; f="$(script close <<AS
on run argv
  set r to resolve(item 1 of argv)
  tell application "Safari" to close tab (item 2 of r) of window (item 1 of r)
  return ""
end run
$RESOLVE
AS
)"
  osa "$TIMEOUT" "$f" "$TAB"
}

# Runs the expression in the tab; prints the value, exits 1 on a JS exception.
run_js() {
  local code="$1" limit="$2"
  code="(
$code
)"
  code="${code//\\/\\\\}"
  code="${code//\"/\\\"}"
  code="${code//$'\n'/\\n}"
  code="${code//$'\r'/\\r}"
  code="${code//$'\t'/\\t}"
  printf '%s' "(function(){ try { var r = eval(\"$code\"); return typeof r === 'string' ? 'str:' + r : 'ok:' + (r === undefined ? '' : JSON.stringify(r)) } catch (e) { return 'err:' + (e && e.message || e) } })()" >"$WORK/code.js"
  local f; f="$(script eval <<AS
on run argv
  set code to read (POSIX file (item 2 of argv)) as «class utf8»
  set r to resolve(item 1 of argv)
  tell application "Safari" to return do JavaScript code in tab (item 2 of r) of window (item 1 of r)
end run
$RESOLVE
AS
)"
  local out
  osa "$limit" "$f" "$TAB" "$WORK/code.js" >"$WORK/result" || return 1
  out="$(cat "$WORK/result"; printf '.')"
  out="${out%.}"
  out="${out%$'\n'}"
  case "$out" in
    str:*) printf '%s' "${out#str:}" ;;
    ok:*) printf '%s\n' "${out#ok:}" ;;
    err:*) echo "safari-cli: JavaScript error: ${out#err:}" >&2; return 1 ;;
    *) echo "safari-cli: unexpected result: $out" >&2; return 1 ;;
  esac
}

cmd_eval() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  output_js "${ARGS[0]}" "$MAX_CHARS"
}

cmd_file() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  [ -r "${ARGS[0]}" ] || die "cannot read ${ARGS[0]}"
  local code
  code="$(cat "${ARGS[0]}"; printf '.')"
  output_js "${code%.}" "$MAX_CHARS"
}

output_js() {
  local code="$1" limit="$2" out total
  if [ -z "$limit" ]; then
    run_js "$code" "$TIMEOUT"
    return
  fi
  run_js "$code" "$TIMEOUT" >"$WORK/output" || return 1
  out="$(cat "$WORK/output"; printf '.')"; out="${out%.}"
  total=${#out}
  if [ "$total" -gt "$limit" ]; then
    printf '%s' "${out:0:limit}"
    echo "safari-cli: truncated to $limit of $total chars" >&2
  else
    printf '%s' "$out"
  fi
}

cmd_info() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  run_js '(function(){ return "title: " + document.title + "\nurl: " + location.href + "\nreadyState: " + document.readyState + "\ninnerText characters: " + (document.body ? document.body.innerText.length : 0) + "\nouterHTML characters: " + (document.documentElement ? document.documentElement.outerHTML.length : 0) + "\n"; })()' "$TIMEOUT"
}

cmd_read() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local selector="$SELECTOR" code
  selector="${selector//\\/\\\\}"
  selector="${selector//\"/\\\"}"
  selector="${selector//$'\n'/\\n}"
  selector="${selector//$'\r'/\\r}"
  selector="${selector//$'\t'/\\t}"
  code="(function(){
    var root = $([ "$SELECTOR_SET" = 1 ] && printf 'document.querySelector("%s")' "$selector" || printf 'document.documentElement');
    if (!root) return 'safari-cli-no-match:';
    var result;
    if ('$cmd' === 'text') {
      result = (root.matches('script, style') ? '' : (root.innerText || '')).replace(/[ \\t]+/g, ' ').replace(/\\n{3,}/g, '\\n\\n');
    } else if ('$cmd' === 'links') {
      var anchors = Array.from(root.querySelectorAll('a'));
      if (root.matches('a')) anchors.unshift(root);
      result = anchors.filter(function(a){ var h = a.getAttribute('href'); return h && h.trim() && !/^javascript:/i.test(h.trim()); }).map(function(a){ return (a.innerText || '').trim().replace(/\\s+/g, ' ') + '\\t' + a.href; }).join('\\n');
    } else if ($RAW) {
      result = root.outerHTML;
    } else {
      var clone = root.cloneNode(true);
      if (clone.matches('script, style, svg, noscript')) return '';
      clone.querySelectorAll('script, style, svg, noscript').forEach(function(e){ e.remove(); });
      clone.removeAttribute('style');
      clone.querySelectorAll('[style]').forEach(function(e){ e.removeAttribute('style'); });
      var walker = document.createTreeWalker(clone, NodeFilter.SHOW_COMMENT), comments = [], node;
      while (node = walker.nextNode()) comments.push(node);
      comments.forEach(function(e){ e.remove(); });
      result = clone.outerHTML;
    }
    return 'safari-cli-result:' + result;
  })()"
  output_read "$code"
}

output_read() {
  run_js "$1" "$TIMEOUT" >"$WORK/read-output" || return 1
  local out total limit="${MAX_CHARS:-20000}"
  out="$(cat "$WORK/read-output"; printf '.')"; out="${out%.}"
  if [ "$out" = 'safari-cli-no-match:' ]; then
    echo "safari-cli: no element matches: $SELECTOR" >&2; return 1
  fi
  out="${out#safari-cli-result:}"; total=${#out}
  if [ "$total" -gt "$limit" ]; then
    printf '%s' "${out:0:limit}"
    echo "safari-cli: truncated to $limit of $total chars" >&2
  else
    printf '%s' "$out"
  fi
}

cmd_snapshot() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local selector="$SELECTOR" code
  selector="${selector//\\/\\\\}"
  selector="${selector//\"/\\\"}"
  selector="${selector//$'\n'/\\n}"
  selector="${selector//$'\r'/\\r}"
  selector="${selector//$'\t'/\\t}"
  code="(function(){ var root = $([ "$SELECTOR_SET" = 1 ] && printf 'document.querySelector("%s")' "$selector" || printf 'document.documentElement');"
  cat >"$WORK/snapshot.js" <<'JS'
    if (!root) return 'safari-cli-no-match:';
    var query = 'a,button,input:not([type="hidden"]),select,textarea,summary,[role="button"],[role="link"],[role="checkbox"],[role="tab"],[role="menuitem"],[role="switch"],[role="option"],[role="combobox"],[role="textbox"],[contenteditable],[onclick],[tabindex]';
    var elements = Array.from(root.querySelectorAll(query));
    if (root.matches(query)) elements.unshift(root);
    function clean(s) { return String(s || '').replace(/\s+/g, ' ').trim(); }
    function cut(s, n) { return s.length > n ? s.slice(0, n - 1) + '…' : s; }
    function unique(s) { try { return document.querySelectorAll(s).length === 1; } catch (_) { return false; } }
    function selectorFor(e) {
      var tag = e.localName, s, value;
      if (e.id && unique(s = '#' + CSS.escape(e.id))) return s;
      for (var attr of ['data-testid', 'name']) {
        value = e.getAttribute(attr);
        if (value && unique(s = tag + '[' + attr + '="' + CSS.escape(value) + '"]')) return s;
      }
      var parts = [], node = e;
      while (node && node.nodeType === 1) {
        if (node.id && unique(s = '#' + CSS.escape(node.id))) {
          parts.unshift(s);
          break;
        }
        var index = 1, sibling = node;
        while (sibling = sibling.previousElementSibling) if (sibling.localName === node.localName) index++;
        parts.unshift(node.localName + ':nth-of-type(' + index + ')');
        node = node.parentElement;
      }
      s = parts.join(' > ');
      return unique(s) ? s : '';
    }
    var lines = [];
    elements.forEach(function(e) {
      if (e.matches('[tabindex]') && !e.matches('a,button,input:not([type="hidden"]),select,textarea,summary,[role="button"],[role="link"],[role="checkbox"],[role="tab"],[role="menuitem"],[role="switch"],[role="option"],[role="combobox"],[role="textbox"],[contenteditable],[onclick]') && e.tabIndex < 0) return;
      if (!e.getClientRects().length || e.closest('[aria-hidden="true"]')) return;
      var style = getComputedStyle(e);
      if (style.display === 'none' || style.visibility === 'hidden' || style.visibility === 'collapse') return;
      var tag = e.localName, type = tag;
      if (tag === 'input') type += '[' + (e.type || 'text') + ']';
      else if (!/^(a|button|select|textarea|summary)$/.test(tag) && e.getAttribute('role')) type += '[role=' + e.getAttribute('role') + ']';
      if (e.checked || e.getAttribute('aria-checked') === 'true') type += ':checked';
      if (e.disabled || e.getAttribute('aria-disabled') === 'true' || e.matches(':disabled')) type += ':disabled';
      var label = clean(e.getAttribute('aria-label')) || clean(e.innerText) || clean(e.getAttribute('placeholder'));
      if (!label && tag !== 'input') label = clean(e.value);
      label = label || clean(e.title) || clean(e.getAttribute('alt')) || clean(e.labels && Array.from(e.labels).map(function(l){ return l.innerText; }).join(' '));
      label = cut(label, 60);
      if (tag === 'select') {
        var selected = clean(Array.from(e.selectedOptions).map(function(o){ return o.label; }).join(', '));
        if (selected && label !== selected) label += (label ? ' = ' : '') + cut(selected, 30);
      } else if (tag === 'input' && e.type !== 'password') {
        var value = clean(e.value);
        if (value) label += (label ? ' = ' : '') + cut(value, 30);
      }
      label = cut(label, 60);
      var selector = selectorFor(e);
      if (selector) lines.push((lines.length + 1) + '\t' + type + '\t' + label + '\t' + selector);
    });
    return 'safari-cli-result:' + lines.join('\n');
  })()
JS
  code+="$(cat "$WORK/snapshot.js")"
  output_read "$code"
}

cmd_wait() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  local deadline=$((SECONDS + TIMEOUT)) out remaining last_error=""
  while :; do
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      [ -z "$last_error" ] || printf '%s\n' "$last_error" >&2
      die "timed out after ${TIMEOUT}s waiting for: ${ARGS[0]}"
    fi
    if out="$(run_js "!!(
${ARGS[0]}
)" "$remaining" 2>"$WORK/wait-error")"; then
      :
    else
      last_error="$(cat "$WORK/wait-error")"
      if grep -q 'JavaScript from Apple Events is off' "$WORK/wait-error"; then
        printf '%s\n' "$last_error" >&2
        return 1
      fi
    fi
    [ "$out" = "true" ] && return 0
    [ "$SECONDS" -ge "$deadline" ] || sleep 0.1
  done
}

cmd_status() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local f
  f="$(script status <<'AS'
on run
  tell application "Safari"
    if (count of windows) = 0 then return "unknown"
    repeat with w from 1 to count of windows
      if (count of tabs of window w) > 0 then
        do JavaScript "1+1" in tab 1 of window w
        return "on"
      end if
    end repeat
    return "unknown"
  end tell
end run
AS
)"
  if osa "$TIMEOUT" "$f" >"$WORK/status"; then
    cat "$WORK/status"
    [ "$(cat "$WORK/status")" = on ]
  else
    if grep -q 'Allow JavaScript from Apple Events' "$WORK/err"; then
      echo off
    fi
    return 1
  fi
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) echo "$VERSION" ;;
  tabs|open|close|eval|file|wait|status|info|text|links|html|snapshot)
    parse "$@"
    [[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo 'safari-cli: timeout must be a positive integer' >&2; exit 2; }
    [ "$BACKGROUND" = 0 ] || [ "$cmd" = open ] || { echo 'safari-cli: --background only applies to open' >&2; exit 2; }
    [ "$JSON" = 0 ] || [ "$cmd" = tabs ] || { echo 'safari-cli: --json only applies to tabs' >&2; exit 2; }
    [ "$SELECTOR_SET" = 0 ] || [[ "$cmd" =~ ^(text|links|html|snapshot)$ ]] || { echo 'safari-cli: --selector only applies to text, links, html, and snapshot' >&2; exit 2; }
    [ "$RAW" = 0 ] || [ "$cmd" = html ] || { echo 'safari-cli: --raw only applies to html' >&2; exit 2; }
    if [ "$MAX_CHARS_SET" = 1 ]; then
      [[ "$MAX_CHARS" =~ ^[1-9][0-9]*$ ]] || { echo 'safari-cli: max-chars must be a positive integer' >&2; exit 2; }
      [[ "$cmd" =~ ^(text|links|html|snapshot|eval|file)$ ]] || { echo 'safari-cli: --max-chars only applies to text, links, html, snapshot, eval, and file' >&2; exit 2; }
    fi
    case "$cmd" in
      text|links|html) cmd_read ;;
      *) "cmd_${cmd//-/_}" ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
