    }
    if (command === 'fill') {
      element.focus();
      if (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) {
        var proto = element instanceof HTMLInputElement ? HTMLInputElement.prototype : HTMLTextAreaElement.prototype;
        Object.getOwnPropertyDescriptor(proto,'value').set.call(element,arg);
        element.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:'insertText',data:arg}));
        element.dispatchEvent(new Event('change',{bubbles:true}));
      } else if (element.isContentEditable) {
        element.textContent = arg;
