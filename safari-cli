  if (board.changeCount !== originalCount) throw new Error('clipboard changed while saving it');
  frontWindow();
  let change = board.clearContents;
  try {
    if (!board.setStringForType(text, $.NSPasteboardTypeString)) throw new Error('could not write clipboard text');
    change = board.changeCount;
    se.keystroke('v', {using: 'command down'});
    // System Events returns after queuing input, before Safari has read the pasteboard.
    $.NSThread.sleepForTimeInterval(0.3);
  } finally {
    if (board.changeCount === change) {
      board.clearContents;
      if (saved.count && !board.writeObjects(saved)) throw new Error('could not restore clipboard contents');
    }
  }
