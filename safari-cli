#!/bin/bash
# Drive the real, logged-in Safari from the shell: list/open/close tabs, run JavaScript in a tab.
# Usage: see `safari-cli help` or README.md. Needs macOS and Safari > Settings > Developer >
# "Allow JavaScript from Apple Events" enabled manually by the user.
set -euo pipefail
export LC_ALL=en_US.UTF-8

VERSION=0.1.0
DEFAULT_TIMEOUT=30

WORK="$(mktemp -d)"
cleanup() {
  local rc=$?
  trap - EXIT
  rm -rf "$WORK"
  exit "$rc"
}
trap cleanup EXIT

die() { echo "safari-cli: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
safari-cli <command> [options]

  tabs                          list tabs: <window>:<tab> <TAB> title <TAB> url
  open <url>                    focus the tab whose URL starts with <url>, else open a new tab; prints <window>:<tab>
  close [--tab T]               close a tab
  eval [--tab T] <js>           run a JavaScript expression, print its value (strings as is, others as JSON)
  file [--tab T] <path.js>      same, with the expression read from a file
  wait [--tab T] <js>           poll until the expression is truthy
  status                        probe JavaScript permission: on, off, or unknown (no window)

--tab T     <window>:<tab> as printed by `tabs`, or a substring of the URL; default: front window's current tab
--background open only: do not activate Safari, raise a window or switch tabs; launches Safari in the background if not running
--timeout N positive integer seconds before commands give up (default 30)
Enable JavaScript from Apple Events once by hand in Safari > Settings > Developer.
This tool never changes that setting and never restarts Safari.
Exit status: 0 ok, 1 error (JS exception, no matching tab, timeout), 2 usage.
EOF
}

# ---- option parsing: sets TAB, TIMEOUT and ARGS (positional) ----
TAB=""; TIMEOUT="$DEFAULT_TIMEOUT"; BACKGROUND=0; ARGS=()
parse() {
  ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --background) BACKGROUND=1; shift ;;
      --tab) [ $# -ge 2 ] || { usage >&2; exit 2; }; TAB="$2"; shift 2 ;;
      --timeout) [ $# -ge 2 ] || { usage >&2; exit 2; }; TIMEOUT="$2"; shift 2 ;;
      --) shift; ARGS+=("$@"); break ;;
      --*) usage >&2; exit 2 ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
}

blocked_message() {
  echo 'safari-cli: JavaScript from Apple Events is off. Turn it on in Safari > Settings > Developer > "Allow JavaScript from Apple Events" (needs Touch ID or a password), then retry.' >&2
}

# ---- AppleScript runner with a timeout; stderr hints for the common failure ----
# Usage: osa <timeout> <script-file> [args...]; prints stdout, returns the exit status.
osa() {
  local limit="$1" script="$2"; shift 2
  local err="$WORK/err" rc=0
  rm -f "$WORK/timed-out"
  osascript "$script" "$@" 2>"$err" &
  local pid=$!
  ( trap 'kill "$sleeper" 2>/dev/null || true; wait "$sleeper" 2>/dev/null || true; exit' TERM INT
    sleep "$limit" & sleeper=$!
    wait "$sleeper"
    touch "$WORK/timed-out"
    kill "$pid" 2>/dev/null || true
  ) >/dev/null 2>&1 &
  local watcher=$!
  wait "$pid" || rc=$?
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  if [ "$rc" -ne 0 ]; then
    if [ -e "$WORK/timed-out" ]; then
      echo "safari-cli: timed out after ${limit}s" >&2
    elif grep -q "Allow JavaScript from Apple Events" "$err"; then
      blocked_message
    else
      sed 's/^[^ ]*: //' "$err" >&2
    fi
  fi
  [ "$rc" -eq 0 ] || return 1
}

script() { cat >"$WORK/$1.applescript"; echo "$WORK/$1.applescript"; }

# Shared handler: resolve a tab spec to {window, tab}.
RESOLVE='
on resolve(spec)
  tell application "Safari"
    if (count of windows) = 0 then error "no Safari window is open"
    if spec is "" then return {1, index of current tab of window 1}
  end tell
  try
    set AppleScript'"'"'s text item delimiters to ":"
    set parts to text items of spec
    set AppleScript'"'"'s text item delimiters to ""
    if (count of parts) = 2 then
      set wi to (item 1 of parts) as integer
      set ti to (item 2 of parts) as integer
      tell application "Safari"
        if wi > 0 and wi ≤ (count of windows) then
          if ti > 0 and ti ≤ (count of tabs of window wi) then return {wi, ti}
        end if
      end tell
    end if
  end try
  set AppleScript'"'"'s text item delimiters to ""
  tell application "Safari"
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        if URL of tab t of window w contains spec then return {w, t}
      end repeat
    end repeat
  end tell
  error "no tab matches: " & spec
end resolve
'

cmd_tabs() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local f; f="$(script tabs <<'AS'
on run
  set out to ""
  tell application "Safari"
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        set u to URL of tab t of window w
        if u is missing value then set u to ""
        set out to out & w & ":" & t & (ASCII character 9) & (name of tab t of window w) & (ASCII character 9) & u & linefeed
      end repeat
    end repeat
  end tell
  if out is not "" then return text 1 thru -2 of out
  return ""
end run
AS
)"
  osa "$TIMEOUT" "$f"
}

cmd_open() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  if [ "$BACKGROUND" = 1 ] && ! pgrep -qx Safari; then
    open -g -a Safari || die "cannot launch Safari"
  fi
  local f; f="$(script open <<'AS'
on run argv
  set u to item 1 of argv
  set bg to (item 2 of argv) is "1"
  tell application "Safari"
    if not bg then activate
    repeat with w from 1 to count of windows
      repeat with t from 1 to count of tabs of window w
        set tu to URL of tab t of window w
        if tu is not missing value and tu starts with u then
          if bg then return (w as text) & ":" & t
          set current tab of window w to tab t of window w
          set index of window w to 1
          return "1:" & t
        end if
      end repeat
    end repeat
    if (count of windows) = 0 then
      make new document with properties {URL:u}
      return "1:1"
    end if
    tell window 1
      set prev to current tab
      set newTab to make new tab with properties {URL:u}
      if bg then
        set current tab to prev
      else
        set current tab to newTab
      end if
    end tell
    return "1:" & (count of tabs of window 1)
  end tell
end run
AS
)"
  osa "$TIMEOUT" "$f" "${ARGS[0]}" "$BACKGROUND"
}

cmd_close() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local f; f="$(script close <<AS
on run argv
  set r to resolve(item 1 of argv)
  tell application "Safari" to close tab (item 2 of r) of window (item 1 of r)
  return ""
end run
$RESOLVE
AS
)"
  osa "$TIMEOUT" "$f" "$TAB"
}

# Runs the expression in the tab; prints the value, exits 1 on a JS exception.
run_js() {
  local code="$1" limit="$2"
  code="(
$code
)"
  code="${code//\\/\\\\}"
  code="${code//\"/\\\"}"
  code="${code//$'\n'/\\n}"
  code="${code//$'\r'/\\r}"
  code="${code//$'\t'/\\t}"
  printf '%s' "(function(){ try { var r = eval(\"$code\"); return typeof r === 'string' ? 'str:' + r : 'ok:' + (r === undefined ? '' : JSON.stringify(r)) } catch (e) { return 'err:' + (e && e.message || e) } })()" >"$WORK/code.js"
  local f; f="$(script eval <<AS
on run argv
  set code to read (POSIX file (item 2 of argv)) as «class utf8»
  set r to resolve(item 1 of argv)
  tell application "Safari" to return do JavaScript code in tab (item 2 of r) of window (item 1 of r)
end run
$RESOLVE
AS
)"
  local out
  osa "$limit" "$f" "$TAB" "$WORK/code.js" >"$WORK/result" || return 1
  out="$(cat "$WORK/result"; printf '.')"
  out="${out%.}"
  out="${out%$'\n'}"
  case "$out" in
    str:*) printf '%s' "${out#str:}" ;;
    ok:*) printf '%s\n' "${out#ok:}" ;;
    err:*) echo "safari-cli: JavaScript error: ${out#err:}" >&2; return 1 ;;
    *) echo "safari-cli: unexpected result: $out" >&2; return 1 ;;
  esac
}

cmd_eval() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  run_js "${ARGS[0]}" "$TIMEOUT"
}

cmd_file() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  [ -r "${ARGS[0]}" ] || die "cannot read ${ARGS[0]}"
  local code
  code="$(cat "${ARGS[0]}"; printf '.')"
  run_js "${code%.}" "$TIMEOUT"
}

cmd_wait() {
  [ ${#ARGS[@]} -eq 1 ] || { usage >&2; exit 2; }
  local deadline=$((SECONDS + TIMEOUT)) out remaining last_error=""
  while :; do
    remaining=$((deadline - SECONDS))
    if [ "$remaining" -le 0 ]; then
      [ -z "$last_error" ] || printf '%s\n' "$last_error" >&2
      die "timed out after ${TIMEOUT}s waiting for: ${ARGS[0]}"
    fi
    if out="$(run_js "!!(
${ARGS[0]}
)" "$remaining" 2>"$WORK/wait-error")"; then
      :
    else
      last_error="$(cat "$WORK/wait-error")"
      if grep -q 'JavaScript from Apple Events is off' "$WORK/wait-error"; then
        printf '%s\n' "$last_error" >&2
        return 1
      fi
    fi
    [ "$out" = "true" ] && return 0
    [ "$SECONDS" -ge "$deadline" ] || sleep 0.1
  done
}

cmd_status() {
  [ ${#ARGS[@]} -eq 0 ] || { usage >&2; exit 2; }
  local f
  f="$(script status <<'AS'
on run
  tell application "Safari"
    if (count of windows) = 0 then return "unknown"
    repeat with w from 1 to count of windows
      if (count of tabs of window w) > 0 then
        do JavaScript "1+1" in tab 1 of window w
        return "on"
      end if
    end repeat
    return "unknown"
  end tell
end run
AS
)"
  if osa "$TIMEOUT" "$f" >"$WORK/status"; then
    cat "$WORK/status"
    [ "$(cat "$WORK/status")" = on ]
  else
    if grep -q 'Allow JavaScript from Apple Events' "$WORK/err"; then
      echo off
    fi
    return 1
  fi
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) echo "$VERSION" ;;
  tabs|open|close|eval|file|wait|status)
    parse "$@"
    [[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo 'safari-cli: timeout must be a positive integer' >&2; exit 2; }
    [ "$BACKGROUND" = 0 ] || [ "$cmd" = open ] || { echo 'safari-cli: --background only applies to open' >&2; exit 2; }
    "cmd_${cmd//-/_}"
    ;;
  *) usage >&2; exit 2 ;;
esac
