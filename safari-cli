function webViewport(element, depth) {
  const role = element.role();
  if (depth > 12 || !['AXWindow', 'AXSplitGroup', 'AXTabGroup', 'AXGroup', 'AXScrollArea'].includes(role)) return null;
  const children = element.uiElements();
  if (role === 'AXScrollArea' && children.some(child => child.role() === 'AXWebArea'))
    return [element.position(), element.size()];
  for (const child of children) {
    const viewport = webViewport(child, depth + 1);
    if (viewport) return viewport;
  }
  return null;
}

function onScreen(x, y) {
  const screens = $.NSScreen.screens;
  for (let i = 0; i < screens.count; i++) {
    const id = screens.objectAtIndex(i).deviceDescription.objectForKey('NSScreenNumber').unsignedIntValue;
    if ($.CGRectContainsPoint($.CGDisplayBounds(id), $.CGPointMake(x, y))) return true;
  }
  return false;
}

