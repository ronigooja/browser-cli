{
  "manifest_version": 3,
  "name": "Agent Browser",
  "version": "4.0.0",
  "description": "Find and read regular Chrome tabs or open them in the background for the local agent-browser tool.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": ["<all_urls>"],
  "action": { "default_title": "Agent Browser: enable viewport capture" },
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js" }
}
