{
  "manifest_version": 3,
  "name": "Agent Browser",
  "version": "1.0.0",
  "description": "Open or reuse background tabs at the request of the local agent-browser tool.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "tabs"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js" }
}
